# ---------------------------------------------------------------------------
# Alwalaa CRM — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres (Supabase). Use the POOLED connection string for the app runtime
# and the DIRECT connection for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alwalaa?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alwalaa?schema=public"

# Supabase Auth / RLS (Phase 6)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Sheets ingestion (Phase 2). Service-account JSON, base64-encoded,
# OR a path to the credentials file. CSV upload works without this.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""

# Outbound alert webhook (Phase 5) — e.g. an n8n endpoint that fans out to
# WhatsApp (Respond.io). Leave blank to disable outbound alerts.
ALERT_WEBHOOK_URL=""

# Shared secret required on inbound calls to /api/ingest and /api/webhooks/*
INTERNAL_API_TOKEN="change-me"
