# Copy to .env.local for development. Do not commit .env.local.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — https://app.supabase.com/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cost guardrail (optional). Aborts an extraction run if the estimated
# Anthropic spend exceeds this many OMR.
MAX_OMR_SPEND_PER_PROJECT=5

# Contact placeholders surfaced in generated listings
NEXT_PUBLIC_ALWALAA_WHATSAPP=+968 0000 0000
NEXT_PUBLIC_ALWALAA_EMAIL=info@alwalaa.om
