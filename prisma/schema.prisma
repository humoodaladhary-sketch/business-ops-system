// Alwalaa Real Estate CRM — data model
// Designed from the Phase 0 audit (docs/phase-0-data-audit.md) and the four
// resolved decisions:
//   1. Hybrid commission split: performance ladder + lead-source floor.
//   2. Multi-agent deal attribution (co-brokered splits are first-class).
//   3. Month attribution driven by Deal.closeDate ("Deal Closed On").
//   4. Developer rate is tier-ready (quarterly volume) but seeded flat.
//
// Money is Decimal(18,3) — OMR has 3 decimal places (baisa). Rates are stored
// as fractions in Decimal(6,4): 3.5% -> 0.0350, 50% -> 0.5000. No floats touch
// commission math. Nothing about rates/tiers/thresholds is hardcoded — it all
// lives in the config tables below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SENIOR
  ADVISOR
  NEW
  TRAINEE
  MARKETING
  FINANCE
  LISTINGS
  CEO
}

enum Segment {
  DIASPORA
  RESIDENT
  NA
}

enum AgentStatus {
  ACTIVE
  PROBATION
  INACTIVE
}

enum LeadSource {
  ALWALAA_SOURCED
  AGENT_NETWORK
}

// The one canonical pipeline. ALL source labels normalize to these.
enum CanonicalStage {
  NEW
  QUALIFIED
  ENGAGED
  VIEWING
  NEGOTIATION
  RESERVATION
  CLOSED_WON
  CLOSED_LOST
}

enum AttributionRole {
  PRIMARY
  CO_BROKER
  REFERRER
}

enum SnapshotStatus {
  PROVISIONAL
  FINAL
}

enum PaidStatus {
  UNPAID
  INVOICED
  RECEIVED
  PAID
}

enum RewardType {
  AGENT_OF_MONTH
  OVERACHIEVER_BONUS
  STREAK_BONUS
}

enum TargetSource {
  ROLE_DEFAULT
  CUSTOM
}

enum ReviewStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum IngestSource {
  CSV
  GOOGLE_SHEETS
  FORM
}

// ---------------------------------------------------------------------------
// People & inventory
// ---------------------------------------------------------------------------

model Agent {
  id                String       @id @default(cuid())
  name              String
  email             String?      @unique
  role              Role
  segment           Segment      @default(NA)
  status            AgentStatus  @default(ACTIVE)
  // New-agent contract: first closed deal activates a 1-year contract.
  contractTriggered Boolean      @default(false)
  contractStartDate DateTime?
  // Ramp window: while now < rampEndDate the agent is exempt from at-risk.
  rampEndDate       DateTime?
  // Trainees are exempt from at-risk regardless of ramp.
  exemptFromAtRisk  Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  targets       Target[]
  attributions  DealAttribution[]
  snapshots     MonthlyPerformanceSnapshot[]
  rewards       Reward[]
  leads         Lead[]
  atRiskReviews AtRiskReview[]
  stageMappings StageMapping[]

  @@index([role])
  @@index([status])
}

model Developer {
  id              String                    @id @default(cuid())
  name            String                    @unique
  canonicalKey    String                    @unique
  paymentReliable Boolean                   @default(true)
  notes           String?
  createdAt       DateTime                  @default(now())
  rules           DeveloperCommissionRule[]
  projects        Project[]
  deals           Deal[]
  aliases         DeveloperAlias[]
}

model Project {
  id           String   @id @default(cuid())
  name         String
  developerId  String
  developer    Developer @relation(fields: [developerId], references: [id])
  location     String?
  priorityRank Int       @default(999)
  signed       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  deals         Deal[]
  leadsInterest Lead[]
  aliases       ProjectAlias[]

  @@unique([developerId, name])
  @@index([priorityRank])
}

// ---------------------------------------------------------------------------
// Leads & deals
// ---------------------------------------------------------------------------

model Lead {
  id              String         @id @default(cuid())
  name            String
  title           String?
  contact         String?
  email           String?
  source          LeadSource     @default(ALWALAA_SOURCED)
  segment         Segment        @default(NA)
  assignedAgentId String?
  assignedAgent   Agent?         @relation(fields: [assignedAgentId], references: [id])
  canonicalStage  CanonicalStage @default(NEW)
  // Audit only — never used by the engine. Raw source label kept for trace.
  rawStageLabel   String?
  projectInterestId String?
  projectInterest Project?       @relation(fields: [projectInterestId], references: [id])
  nationality       String?
  countryOfResidence String?
  budgetBand      String?
  purpose         String?
  timeline        String?
  language        String?
  currency        String?
  notes           String?
  registeredAt    DateTime?
  lastFollowUpAt  DateTime?
  stagingRowId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deals Deal[]

  @@index([canonicalStage])
  @@index([assignedAgentId])
  @@index([source])
}

model Deal {
  id             String         @id @default(cuid())
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id])
  developerId    String
  developer      Developer      @relation(fields: [developerId], references: [id])
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id])
  dealValue      Decimal        @db.Decimal(18, 3) // OMR, excl. VAT, per SPA
  canonicalStage CanonicalStage @default(RESERVATION)
  unitType       String?
  unitNumber     String?
  // Reservation kept for funnel analytics; closeDate drives the month (Decision 3).
  reservationDate DateTime?
  closeDate      DateTime?
  notes          String?
  stagingRowId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  attributions DealAttribution[]
  commissions  Commission[]

  @@index([closeDate])
  @@index([developerId])
  @@index([canonicalStage])
}

// Decision 2 — a deal can credit several agents. Shares sum to 1.0.
model DealAttribution {
  id        String          @id @default(cuid())
  dealId    String
  deal      Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent           @relation(fields: [agentId], references: [id])
  sharePct  Decimal         @db.Decimal(6, 4) // fraction of the deal credited to this agent
  role      AttributionRole @default(PRIMARY)
  createdAt DateTime        @default(now())

  commission Commission?

  @@unique([dealId, agentId])
  @@index([agentId])
}

// ---------------------------------------------------------------------------
// Targets & commission configuration (all editable — never hardcoded)
// ---------------------------------------------------------------------------

model Target {
  id           String       @id @default(cuid())
  agentId      String
  agent        Agent        @relation(fields: [agentId], references: [id])
  period       String // 'YYYY-MM'
  targetAmount Decimal      @db.Decimal(18, 3)
  source       TargetSource @default(ROLE_DEFAULT)

  @@unique([agentId, period])
}

// The 25/35/40/50 ladder. agentSplitRate resolved from whole-month % of target.
model CommissionLadder {
  id             String   @id @default(cuid())
  tierName       String   @unique
  minPctOfTarget Decimal  @db.Decimal(7, 4) // inclusive, fraction (0.50 = 50%)
  maxPctOfTarget Decimal? @db.Decimal(7, 4) // exclusive; null = open-ended top tier
  agentSplitRate Decimal  @db.Decimal(6, 4) // fraction (0.50 = 50%)
  sortOrder      Int

  @@index([sortOrder])
}

// Decision 1 — hybrid floor. Own/referral leads never fall below their floor.
model LeadSourceFloor {
  id             String     @id @default(cuid())
  source         LeadSource @unique
  floorSplitRate Decimal    @db.Decimal(6, 4) // fraction; 0 = no floor (ladder only)
  note           String?
}

// Decision 4 — tier-ready by cumulative quarterly volume; seeded as one flat row.
model DeveloperCommissionRule {
  id                String    @id @default(cuid())
  developerId       String
  developer         Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  tierName          String?
  minQuarterlyVolume Decimal  @db.Decimal(18, 3) @default(0)
  maxQuarterlyVolume Decimal? @db.Decimal(18, 3)
  rate              Decimal   @db.Decimal(6, 4) // developer -> Alwalaa, fraction

  @@unique([developerId, minQuarterlyVolume])
}

// ---------------------------------------------------------------------------
// Computed outputs
// ---------------------------------------------------------------------------

model MonthlyPerformanceSnapshot {
  id              String         @id @default(cuid())
  agentId         String
  agent           Agent          @relation(fields: [agentId], references: [id])
  period          String // 'YYYY-MM'
  volumeClosed    Decimal        @db.Decimal(18, 3)
  targetAmount    Decimal        @db.Decimal(18, 3)
  pctOfTarget     Decimal        @db.Decimal(7, 4)
  currentTier     String
  currentSplitRate Decimal       @db.Decimal(6, 4)
  projectedPayout Decimal        @db.Decimal(18, 3)
  finalPayout     Decimal?       @db.Decimal(18, 3)
  status          SnapshotStatus @default(PROVISIONAL)
  dealCount       Int            @default(0)
  watchFlag       Boolean        @default(false)
  atRiskFlag      Boolean        @default(false)
  computedAt      DateTime       @default(now())

  @@unique([agentId, period])
  @@index([period])
}

model Commission {
  id                String          @id @default(cuid())
  dealId            String
  deal              Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  attributionId     String          @unique
  attribution       DealAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  developerRate     Decimal         @db.Decimal(6, 4)
  alwalaaGross      Decimal         @db.Decimal(18, 3) // dealValue*share*developerRate
  agentSplitRate    Decimal         @db.Decimal(6, 4)
  agentPayout       Decimal         @db.Decimal(18, 3) // alwalaaGross*agentSplitRate
  developerPaid     PaidStatus      @default(UNPAID)
  agentPaid         PaidStatus      @default(UNPAID)
  paidDate          DateTime?
  attributionReason String // raw lead-source reason, for audit/override
  overrideNote      String?
  computedAt        DateTime        @default(now())

  @@index([dealId])
}

model Reward {
  id        String     @id @default(cuid())
  agentId   String
  agent     Agent      @relation(fields: [agentId], references: [id])
  period    String
  type      RewardType
  amount    Decimal    @db.Decimal(18, 3) @default(0)
  note      String?
  createdAt DateTime   @default(now())

  @@unique([agentId, period, type])
}

model AtRiskReview {
  id         String       @id @default(cuid())
  agentId    String
  agent      Agent        @relation(fields: [agentId], references: [id])
  period     String
  reason     String
  assignedTo String       @default("CEO")
  status     ReviewStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@unique([agentId, period])
}

// ---------------------------------------------------------------------------
// Normalization dictionaries (seeded from the Phase 0 audit)
// ---------------------------------------------------------------------------

model StageMapping {
  id             String         @id @default(cuid())
  sourceLabel    String
  canonicalStage CanonicalStage
  // Null agentId = global mapping; set = per-agent override.
  agentId        String?
  agent          Agent?         @relation(fields: [agentId], references: [id])
  note           String?

  @@unique([sourceLabel, agentId])
}

model DeveloperAlias {
  id          String    @id @default(cuid())
  alias       String    @unique // normalized lowercase source string
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
}

model ProjectAlias {
  id        String  @id @default(cuid())
  alias     String  @unique
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Ingestion staging — APPEND ONLY. Never updated or deleted by app code.
// ---------------------------------------------------------------------------

model StagingBatch {
  id         String       @id @default(cuid())
  source     IngestSource
  sourceRef  String? // file name, sheet id, or form id
  agentName  String?
  uploadedAt DateTime     @default(now())
  rowCount   Int          @default(0)

  rows   StagingRow[]
  errors IngestionError[]
}

model StagingRow {
  id        String       @id @default(cuid())
  batchId   String
  batch     StagingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex  Int
  sheetTab  String?
  raw       Json
  createdAt DateTime     @default(now())

  @@index([batchId])
}

model IngestionError {
  id        String       @id @default(cuid())
  batchId   String
  batch     StagingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex  Int
  raw       Json
  errors    Json
  createdAt DateTime     @default(now())

  @@index([batchId])
}
